APP_NAME="RDSCO License Manager"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.rahkar-digital.ir
APP_TIMEZONE=Asia/Tehran

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
TRUSTED_PROXIES=

# One-time token for the /setup page (first admin + migrations).
# Remove it after setup.
SETUP_TOKEN=

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rdsco_license
DB_USERNAME=root
DB_PASSWORD=

# File-based sessions and cache need no extra services on shared hosting.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=log

# License API
LICENSE_OFFLINE_GRACE_HOURS=72
LICENSE_SIGNATURE_TOLERANCE=300
LICENSE_CACHE_SECONDS=300
LICENSE_RATE_VERIFY=120
LICENSE_RATE_SHAHKAR=60
LICENSE_RATE_ERRORS=60
LICENSE_RATE_PER_IP=600

# In-app updater (Admin panel -> System update).
# The token is only needed for a private repository: fine-grained, read-only "Contents".
UPDATER_REPOSITORY=masoodvahid/rdsco-license-manager
UPDATER_GITHUB_TOKEN=
# UPDATER_DOMAIN_ROOT=/home/rahkardi/domains/api.rahkar-digital.ir
UPDATER_KEEP_BACKUPS=3

VITE_APP_NAME="${APP_NAME}"
